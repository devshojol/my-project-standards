# Copy to .env for local runs. Validated at startup by src/config.js (Zod), the only file that reads process.env;
# the process exits on a missing or invalid value. Never put real secrets in this file.

# Runtime. An unset NODE_ENV behaves as production (no error details leave the server).
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent. Default: info (debug in development).
LOG_LEVEL=

# MongoDB replica set (transactions need one). Tests start their own in-memory replica set.
APP_MONGO_URI=mongodb://localhost:27017/app?replicaSet=rs0

# Token signing secrets: long random strings, one pair per environment.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Comma-separated browser origins allowed by CORS. Mobile clients send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:3000

# Optional. Without it, rate limits and caches fail open and the worker refuses to start.
REDIS_URL=

# Optional. Error reporting; unset → off.
SENTRY_DSN=
